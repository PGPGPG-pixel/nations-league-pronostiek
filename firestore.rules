rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: each user document keyed by UID
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Username index to enforce uniqueness: doc id is sanitized username
    match /usernames/{username} {
      allow read: if true;
      // creating a username doc is only allowed when authenticated and the doc does not exist
      allow create: if request.auth != null
                     && request.resource.data.userId == request.auth.uid
                     && !exists(/databases/$(database)/documents/usernames/$(username));
      allow delete: if request.auth != null && get(/databases/$(database)/documents/usernames/$(username)).data.userId == request.auth.uid;
      allow update: if false;
    }

    // Matches: readable by authenticated users; writable only by admins
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Groups: group documents hold memberIds array and ownerId
    match /groups/{groupId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      // create allowed when authenticated; creator should include themselves in memberIds
      allow create: if request.auth != null && request.resource.data.memberIds is list && request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Group red cards: document per group storing red-card assignments per match
    match /groupRedCards/{groupId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      // allow create/update/delete only for group members
      allow create, update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Predictions: users can create/update their own predictions only before match cutoff (1 hour before match)
    match /predictions/{predId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.matchId is string
        && exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId))
        && request.time < get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.date - duration.value(1, 'h');

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.time < get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.date - duration.value(1, 'h');

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

  }
}
